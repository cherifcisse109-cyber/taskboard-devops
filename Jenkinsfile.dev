// Pipeline 2 : Build complet sur push de la branche dev
// Job Jenkins : Multibranch Pipeline (ou Pipeline classique branche dev), webhook GitHub "push"
// Script Path : Jenkinsfile.dev

def NODE_VERSIONS = ['18', '20', '22']    // build parallele par version de runtime
def SAFE_TAG      = { env.BUILD_TAG.replaceAll('[^a-zA-Z0-9_.-]', '_') }

pipeline {
  agent any
  environment {
    // Agent Jenkins sous Windows : rend sh/bash/sed/grep... (Git for Windows) visibles par l'etape sh
    PATH = "C:\\Program Files\\Git\\usr\\bin;C:\\Program Files\\Git\\bin;${env.PATH}"
  }
  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '10'))
    disableConcurrentBuilds()
  }
  parameters {
    booleanParam(name: 'FORCE_SMOKE_FAIL', defaultValue: false,
                 description: 'Demo : force un echec du smoke test')
  }

  stages {
    stage('Build complet (dev)') {
      when { branch 'dev' }
      stages {

        stage('Checkout') {
          steps {
            checkout scm
            sh 'rm -rf artifacts && mkdir -p artifacts/logs && git log -1 --pretty=format:"%h %an : %s" | tee artifacts/last-commit.txt'
          }
        }

        stage('Setup') {
          steps {
            sh '''
              docker --version
              sed -i 's/\\r$//' scripts/smoke.sh
              chmod +x scripts/smoke.sh
            '''
          }
        }

        stage('Build') {
          steps {
            script {
              parallel NODE_VERSIONS.collectEntries { v ->
                ["Build Node ${v}": {
                  sh """#!/bin/bash
                    set -o pipefail
                    docker build --build-arg NODE_VERSION=${v} --build-arg APP_VERSION=dev-${env.BUILD_NUMBER} \\
                      -t taskboard:dev-${env.BUILD_NUMBER}-node${v} app 2>&1 | tee artifacts/logs/build-node${v}.log
                  """
                }]
              }
            }
          }
        }

        stage('Run (Docker)') {
          steps {
            script {
              parallel NODE_VERSIONS.collectEntries { v ->
                ["Run Node ${v}": {
                  sh """
                    docker run -d --name tb-${SAFE_TAG()}-n${v} --label ci=${SAFE_TAG()} \\
                      -p ${3000 + v.toInteger()}:3000 taskboard:dev-${env.BUILD_NUMBER}-node${v}
                  """
                }]
              }
            }
          }
        }

        stage('Smoke Test') {
          steps {
            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
              script {
                def force = params.FORCE_SMOKE_FAIL ? '1' : '0'
                parallel NODE_VERSIONS.collectEntries { v ->
                  ["Smoke Node ${v}": {
                    sh "SMOKE_FORCE_FAIL=${force} ./scripts/smoke.sh http://${env.SMOKE_HOST ?: 'localhost'}:${3000 + v.toInteger()} artifacts/smoke-node${v}.txt"
                  }]
                }
              }
            }
          }
        }

        stage('Archive Artifacts') {
          steps {
            sh """#!/bin/bash
              for c in \$(docker ps -aq --filter label=ci=${SAFE_TAG()}); do
                docker logs \$c > artifacts/logs/container-\$(docker inspect -f '{{.Name}}' \$c | tr -d /).log 2>&1 || true
              done
              {
                echo "Pipeline      : Build complet (push dev)"
                echo "Job / Build   : ${env.JOB_NAME} #${env.BUILD_NUMBER}"
                echo "Branche       : ${env.BRANCH_NAME}"
                echo "Date          : \$(date -u +%FT%TZ)"
                echo "--- Resultats smoke ---"
                grep -H RESULT artifacts/smoke-node*.txt || echo "aucun resultat smoke"
              } > artifacts/pipeline-report.txt
            """
            archiveArtifacts artifacts: 'artifacts/**', fingerprint: true, allowEmptyArchive: true
          }
        }
      }
    }
  }

  post {
    always {   // Cleanup
      sh """
        docker ps -aq --filter label=ci=${SAFE_TAG()} | xargs -r docker rm -f || true
        docker images -q 'taskboard:dev-${env.BUILD_NUMBER}-*' | xargs -r docker rmi -f || true
      """
    }
    success { echo 'DEV : BUILD COMPLET PASSED' }
    failure { echo 'DEV : BUILD COMPLET FAILED' }
  }
}
